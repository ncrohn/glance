{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    "allow-read-file",
    "allow-write-file",
    "allow-resolve-open-target",
    "allow-canonicalize-path",
    "allow-watch-file",
    "allow-unwatch-file",
    "allow-watch-annotations",
    "allow-read-annotations",
    "allow-add-annotation",
    "allow-remove-annotation",
    "allow-update-annotation",
    "allow-add-reply",
    "allow-resolve-anchors",
    "allow-ensure-annotation-store",
    "allow-read-reviewed",
    "allow-write-reviewed",
    "allow-list-integration-targets",
    "allow-run-integration",
    "allow-set-show-in-finder-enabled",
    "allow-take-launch-args",
    "allow-quit-app",
    "allow-quit-ack",
    "allow-resolve-wikilink"
  ]
}
